                <Border x:Name="ChartBorder" BorderBrush="Gray" BorderThickness="1">
                    <Grid x:Name="RootGrid">
                        <!-- Scrollable 原始网格 -->
                        <ScrollViewer x:Name="ChartScroll"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="MainGrid" Height="1250">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="250" />
                                    <RowDefinition Height="250" />
                                    <RowDefinition Height="250" />
                                    <RowDefinition Height="250" />
                                    <RowDefinition Height="250" />
                                </Grid.RowDefinitions>

                                <!-- 这里放你的 PlotView（保持原来的布局） -->
                                <!-- Row 0 -->
                                <oxy:PlotView Grid.Row="0" Model="{Binding RawDataPlotModel}"
                              Controller="{Binding RawDataChart.plotController}"
                              MouseDoubleClick="PlotView_MouseDoubleClick" Tag="RawData" />
                                <!-- Row 1 -->
                                <oxy:PlotView Grid.Row="1" Model="{Binding BrainwavePlotModel}"
                              Controller="{Binding BrainwaveChart.plotController}"
                              MouseDoubleClick="PlotView_MouseDoubleClick" Tag="Brainwave" />
                                <!-- Row 2 -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <oxy:PlotView Grid.Column="0" Model="{Binding FocusPlotModel}"
                                  Controller="{Binding FocusChart.plotController}"
                                  MouseDoubleClick="PlotView_MouseDoubleClick" Tag="Focus" />
                                    <oxy:PlotView Grid.Column="1" Model="{Binding MeditationPlotModel}"
                                  Controller="{Binding MeditationChart.plotController}"
                                  MouseDoubleClick="PlotView_MouseDoubleClick" Tag="Meditation" />
                                </Grid>
                                <!-- Row 3 -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <oxy:PlotView Grid.Column="0" Model="{Binding RelaxationPlotModel}"
                                  Controller="{Binding RelaxationChart.plotController}"
                                  MouseDoubleClick="PlotView_MouseDoubleClick" Tag="Relaxation" />
                                    <oxy:PlotView Grid.Column="1" Model="{Binding TiredPlotModel}"
                                  Controller="{Binding TiredChart.plotController}"
                                  MouseDoubleClick="PlotView_MouseDoubleClick" Tag="Tired" />
                                </Grid>
                                <!-- Row 4 -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />

                                        <!--<ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />-->
                                    </Grid.ColumnDefinitions>
                                    <oxy:PlotView Grid.Column="0" Model="{Binding EmotionPlotModel}"
                                  Controller="{Binding EmotionChart.plotController}"
                                  MouseDoubleClick="PlotView_MouseDoubleClick" Tag="Emotion" />
                                    <!--<oxy:PlotView Grid.Column="1" Model="{Binding BlinkPlotModel}"
