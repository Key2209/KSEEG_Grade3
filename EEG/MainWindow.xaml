                                  MouseDoubleClick="PlotView_MouseDoubleClick" Tag="Blink" />
                                    <oxy:PlotView Grid.Column="2" Model="{Binding GnashPlotModel}"
                                  Controller="{Binding GnashChart.plotController}"
                                  MouseDoubleClick="PlotView_MouseDoubleClick" Tag="Gnash" />-->
                                </Grid>
                            </Grid>
                        </ScrollViewer>

                        <!-- Overlay Grid 放在 RootGrid 最上层，用于放大 PlotView -->
                        <Grid x:Name="OverlayGrid" Background="#80000000" Visibility="Collapsed"/>
                    </Grid>
                </Border>










