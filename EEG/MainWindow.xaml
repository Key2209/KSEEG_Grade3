<Window
    x:Class="EEG.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:EEG"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vm="clr-namespace:EEG.ViewModel"
    xmlns:oxy="http://oxyplot.org/wpf"
    Title="Kingsense KSEEG Evaluation Software"
    Width="1150"
    Height="700"
    d:DataContext="{d:DesignInstance vm:MainViewModel,
                                     IsDesignTimeCreatable=False}"
    Icon="/Picture/favicon.ico"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>


        </ResourceDictionary>

    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="25*" />
            <RowDefinition Height="*">
            </RowDefinition>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="#518FAE">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Width="100"
                        Margin="20,0,1,0"
                        Style="{StaticResource RoundedButtonStyle}"
                        Command="{Binding ScanCommand}">
                        BLE
                    </Button>
                    <ComboBox
                        Width="295"
                        Margin="0"
                        Style="{StaticResource RoundedComboBoxStyle}"
                        ItemsSource="{Binding DeviceList_show}"
                        DisplayMemberPath="DisplayInfo"
                        SelectedItem="{Binding SelectedDevice_show, Mode=TwoWay}">

                    </ComboBox>
                    <Button
                        Width="100"
                        Margin="30,0,0,0"
                        Style="{StaticResource RoundedButtonStyle}"
                        Command="{Binding ConnectCommand}">
                        Connect
                    </Button>
                    <Button
                        Width="100"
                        Margin="5,0,0,0"
                        Style="{StaticResource RoundedButtonStyle}"
                        Command="{Binding DisconnectCommand}">
                        Disconnet
                    </Button>
                    <Button
                        Width="100"
                        Margin="50,0,0,0"
                        d:Content="Save"
                        d:Background="#CECECE"
                        Style="{StaticResource SaveButtonStyle}"
                        Background="{Binding SaveButtonBrush}"
                        Content="{Binding SaveButtonContent}"
                        Command="{Binding SaveCommand}">

                    </Button>

                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">


                    <Image
                        Name="Ble_image"
                        Width="35"
                        Height="35"
                        Margin="0,0,15,0"
                        d:Source="/Picture/关闭蓝牙_turn-off-bluetooth.png"
                        Source="{Binding BleImageSource}" />
                    <Image
                        Width="40"
                        Height="40"
                        Margin="0,0,15,0"
                        d:Source="/Picture/头部脱落2.png"
                        Source="{Binding HeadImageSource}">
                    </Image>

                    <Image
                        Name="Battery_image"
                        Width="40"
                        Height="50"
                        Margin="0,0,15,0"
                        d:Source="/Picture/电池-满电.png"
                        Source="{Binding BatteryImageSource}">
                        <!-- 鼠标悬停时显示电量 -->
                        <Image.ToolTip>
                            <TextBlock Text="{Binding BatteryLevel, StringFormat=Battery:{0:F0}%}" />
                        </Image.ToolTip>
                    </Image>
                    <Image
                        Name="Set_image"
                        Width="35"
                        Height="35"
                        Margin="0,0,20,0"
                        Source="/Picture/设置_setting-two.png">
                        <Image.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenSettingsCommand}">
                            </MouseBinding>
                        </Image.InputBindings>
                    </Image>
                </StackPanel>
            </Grid>
        </Border>



        <Border Grid.Row="1" Background="#DEEBF6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="OXY"
                    Grid.Row="0"
                    Background="#DEEBF6">

                    <ScrollViewer
                        x:Name="ChartScroll"
                        VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="MainGrid" Height="1250">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="250" />
                                <RowDefinition Height="250" />
                                <RowDefinition Height="250" />
                                <RowDefinition Height="250" />
                                <RowDefinition Height="250" />
                            </Grid.RowDefinitions>
                            <oxy:PlotView
                                Grid.Row="0"
                                Model="{Binding RawDataPlotModel}"
                                Controller="{Binding RawDataChart.plotController}"
                                MouseDoubleClick="PlotView_MouseDoubleClick" />
                            <oxy:PlotView
                                Grid.Row="1"
                                Model="{Binding BrainwavePlotModel}"
                                Controller="{Binding BrainwaveChart.plotController}"
                                MouseDoubleClick="PlotView_MouseDoubleClick" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <oxy:PlotView
                                    Grid.Column="0"
                                    Model="{Binding FocusPlotModel}"
                                    Controller="{Binding FocusChart.plotController}"
                                    MouseDoubleClick="PlotView_MouseDoubleClick" />
                                <oxy:PlotView
                                    Grid.Column="1"
                                    Model="{Binding MeditationPlotModel}"
                                    Controller="{Binding MeditationChart.plotController}"
                                    MouseDoubleClick="PlotView_MouseDoubleClick" />
                            </Grid>
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <oxy:PlotView
                                    Grid.Column="0"
                                    Model="{Binding RelaxationPlotModel}"
                                    Controller="{Binding RelaxationChart.plotController}"
                                    MouseDoubleClick="PlotView_MouseDoubleClick" />
                                <oxy:PlotView
                                    Grid.Column="1"
                                    Model="{Binding TiredPlotModel}"
                                    Controller="{Binding TiredChart.plotController}"
                                    MouseDoubleClick="PlotView_MouseDoubleClick" />
                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <oxy:PlotView
                                    Grid.Column="0"
                                    Model="{Binding EmotionPlotModel}"
                                    Controller="{Binding EmotionChart.plotController}"
                                    MouseDoubleClick="PlotView_MouseDoubleClick" />
                                <oxy:PlotView
                                    Grid.Column="1"
                                    Model="{Binding BlinkPlotModel}"
                                    Controller="{Binding BlinkChart.plotController}"
                                    MouseDoubleClick="PlotView_MouseDoubleClick" />
                                <oxy:PlotView
                                    Grid.Column="2"
                                    Model="{Binding GnashPlotModel}"
                                    Controller="{Binding GnashChart.plotController}"
                                    MouseDoubleClick="PlotView_MouseDoubleClick" />

                            </Grid>

                        </Grid>
                    </ScrollViewer>


                </Border>

                <Border Grid.Row="1" Background="#E1E5E6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Width="180"
                            Margin="10"
                            Padding="5"
                            Background="#CECECE"
                            CornerRadius="5">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="MAX30102"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#964051"
                                FontFamily="Segoe UI" />
                        </Border>
                        <Border
                            Grid.Row="1"
                            Width="180"
                            Margin="10"
                            Padding="5"
                            Background="#CECECE"
                            CornerRadius="5">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="MPU6050"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#964051"
                                FontFamily="Segoe UI" />
                        </Border>
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,5,0,5"
                            Padding="10"
                            Background="#CECECE"
                            CornerRadius="1">
                            <TextBox
                                Width="888"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding MAX30102_INF}"
                                FontSize="16"
                                FontWeight="Bold"
                                FontFamily="Segoe UI"
                                Background="#CECECE"
                                Foreground="#2B579A"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                IsReadOnly="True"
                                TextAlignment="Center" />

                        </Border>
                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,5,0,5"
                            Padding="10"
                            Background="#CECECE"
                            CornerRadius="1">
                            <TextBox
                                Width="888"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding MPU6050_INF}"
                                FontSize="16"
                                FontWeight="Bold"
                                FontFamily="Segoe UI"
                                Background="#CECECE"
                                Foreground="#2B579A"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                IsReadOnly="True"
                                TextAlignment="Center" />

                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>




        <Border Grid.Row="2" Background="#508DAC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <TextBlock
                    Grid.Column="0"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    Foreground="#804051">
                    www.ks-chip.com
                </TextBlock>
                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    Foreground="#804051">
                    copyright@Kingsense
                </TextBlock>
                <TextBlock
                    Grid.Column="2"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    Foreground="#804051">
                    Version:2.4
                </TextBlock>
            </Grid>

        </Border>
    </Grid>
</Window>
