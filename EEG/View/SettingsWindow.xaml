                <Border Style="{StaticResource SettingGroupTitle}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="System Version"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#964051"
                        FontFamily="Segoe UI" />
                </Border>
                <Grid Style="{StaticResource SettingItemGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左边名称 -->
                    <TextBlock
                        Grid.Column="0"
                        Text="Software Version:"
                        Style="{StaticResource SettingNameTextBlock}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="2.3"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#964051"
                        FontFamily="Segoe UI" />
                </Grid>
                <Grid Style="{StaticResource SettingItemGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左边名称 -->
                    <TextBlock
                        Grid.Column="0"
                        Text="Firmware Version:"
                        Style="{StaticResource SettingNameTextBlock}" />
                    <TextBlock
                        x:Name="VersionTextBlock"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#964051"
                        FontFamily="Segoe UI" />

                </Grid>


            </StackPanel>
        </ScrollViewer>

    </Grid>


